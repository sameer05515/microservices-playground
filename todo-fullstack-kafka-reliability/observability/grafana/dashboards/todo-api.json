{
  "title":"Todo API Overview",
  "uid":"todo-api",
  "schemaVersion":39,
  "version":1,
  "refresh":"10s",
  "panels":[
    {"type":"timeseries","title":"HTTP Request Rate","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{application=\"todo-api\"}[1m]))","legendFormat":"requests/sec"}]},
    {"type":"timeseries","title":"HTTP P95 Latency","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"todo-api\"}[5m])))","legendFormat":"p95"}]},
    {"type":"timeseries","title":"Redis Cache Hits vs Misses","gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"expr":"rate(todo_cache_hits_total[1m])","legendFormat":"hits"},{"expr":"rate(todo_cache_misses_total[1m])","legendFormat":"misses"}]},
    {"type":"timeseries","title":"Rate Limit Rejections","gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"expr":"rate(todo_rate_limit_rejected_total[1m])","legendFormat":"rejected/sec"}]},
    {"type":"timeseries","title":"JVM Memory Used","gridPos":{"x":0,"y":16,"w":12,"h":8},"targets":[{"expr":"jvm_memory_used_bytes{application=\"todo-api\"}","legendFormat":"{{area}}"}]},
    {"type":"timeseries","title":"Redis Lock Contentions","gridPos":{"x":12,"y":16,"w":12,"h":8},"targets":[{"expr":"rate(todo_lock_contentions_total[1m])","legendFormat":"contentions/sec"}]}
  ]
}
