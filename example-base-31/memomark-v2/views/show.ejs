<%- include("partials/header") %>

<div class="note-header">
  <div>
    <a class="back-link" href="/">← All Notes</a>
    <h1><%= note.title %></h1>

    <% if (note.tags.length) { %>
      <div class="tags">
        <% note.tags.forEach(item => { %>
          <a class="tag" href="/?tag=<%= encodeURIComponent(item) %>">
            #<%= item %>
          </a>
        <% }) %>
      </div>
    <% } %>

    <p class="muted">
      Updated <%= new Date(note.updatedAt).toLocaleString() %>
    </p>
  </div>

  <div class="actions">
    <a class="btn" href="/notes/<%= note.id %>/edit">Edit</a>

    <form method="post" action="/notes/<%= note.id %>/duplicate">
      <button class="btn" type="submit">Duplicate</button>
    </form>

    <form method="post"
          action="/notes/<%= note.id %>/delete"
          onsubmit="return confirm('Delete this note?');">
      <button class="btn btn-danger" type="submit">Delete</button>
    </form>
  </div>
</div>

<article class="markdown-body">
  <%- markdown(note.content) %>
</article>

<script>
  document.querySelectorAll("pre code").forEach(block => {
    hljs.highlightElement(block);
  });
</script>

<%- include("partials/footer") %>
