<!doctype html><html><head><title><%=title%> - Mini Gmail</title><link rel="stylesheet" href="/css/style.css"></head><body><%-include("partials/header")%><div class="layout"><%-include("partials/sidebar")%><main><div class="toolbar"><h2><%=title%></h2><span><%=emails.length%> messages</span></div><div class="list"><%if(!emails.length){%><div class="empty">No messages</div><%}%><%emails.forEach(e=>{%><div class="row <%=!e.read&&!e.draft?'unread':''%>"><form method="post" action="/mail/star/<%=e.id%>"><button class="icon"><%=e.starred?'★':'☆'%></button></form><a href="/mail/view/<%=e.id%>"><strong><%=title==='Sent'?'To: '+e.to:e.from%></strong><b><%=e.subject||'(no subject)'%></b><span><%=e.body.substring(0,80).replace(/\n/g,' ')%></span><small><%=new Date(e.date).toLocaleString()%></small></a><%if(title==='Trash'){%><form method="post" action="/mail/restore/<%=e.id%>"><button class="mini">Restore</button></form><form method="post" action="/mail/delete/<%=e.id%>"><button class="mini danger">Delete</button></form><%}else if(e.draft){%><a class="mini" href="/mail/compose?draft=<%=e.id%>">Edit</a><%}else{%><form method="post" action="/mail/trash/<%=e.id%>"><button class="icon">🗑</button></form><%}%></div><%})%></div></main></div></body></html>