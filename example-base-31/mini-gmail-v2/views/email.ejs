<!doctype html><html><head><title><%=email.subject%></title><link rel="stylesheet" href="/css/style.css"></head><body><%-include("partials/header")%><div class="layout"><%-include("partials/sidebar",{page:"inbox",unread:0})%><main><article class="message"><h1><%=email.subject%></h1><div class="meta"><b><%=email.from%></b> → <%=email.to%> · <%=new Date(email.date).toLocaleString()%></div><hr><div class="body"><%=email.body%></div><div class="actions"><a class="button" href="/mail/reply/<%=email.id%>">↩ Reply</a><a class="button secondary" href="/mail/forward/<%=email.id%>">↪ Forward</a><form method="post" action="/mail/trash/<%=email.id%>"><button class="danger">🗑 Delete</button></form></div></article></main></div></body></html>