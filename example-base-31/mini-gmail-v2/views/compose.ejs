<!doctype html><html><head><title>Compose</title><link rel="stylesheet" href="/css/style.css"></head><body><%-include("partials/header")%><div class="layout"><%-include("partials/sidebar",{page:""})%><main><div class="compose-card"><h2><%=email?"Edit / Compose":"New message"%></h2><%if(error){%><div class="error"><%=error%></div><%}%><form method="post" action="/mail/send"><%if(email&&email.id){%><input type="hidden" name="id" value="<%=email.id%>"><%}%><input name="to" type="email" placeholder="To" value="<%=email?.to||''%>" required><input name="subject" placeholder="Subject" value="<%=email?.subject||''%>" required><textarea name="body" placeholder="Message" required><%=email?.body||''%></textarea><div class="actions"><button>Send</button><button type="submit" formaction="/mail/draft" class="secondary">Save draft</button><a href="/mail/inbox">Cancel</a></div></form></div></main></div></body></html>