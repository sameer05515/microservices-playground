<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Revision Hub</title><link rel="stylesheet" href="/styles.css"></head><body>
<aside class="sidebar"><a class="brand" href="/">✦ Revision<span>Hub</span></a><p class="navlabel">WORKSPACE</p><a class="<%=page==='dashboard'?'active':''%>" href="/?page=dashboard">▦ Overview</a><a class="<%=page==='topics'?'active':''%>" href="/?page=topics">◈ Topics <b><%=topics.length%></b></a><a class="<%=page==='questions'?'active':''%>" href="/?page=questions">☷ Question bank <b><%=questions.length%></b></a><a class="<%=page==='tracking'?'active':''%>" href="/?page=tracking">◷ Revision tracking <b><%=revisions.length%></b></a><div class="side-note"><b>Small steps add up.</b><p>One question revised today is better than a perfect plan for tomorrow.</p></div></aside>
<main><header><div><small>YOUR PERSONAL LEARNING SPACE</small><h1><%=({dashboard:'Overview',topics:'Topic management',questions:'Question bank',tracking:'Revision tracking'})[page]||'Overview'%></h1></div><span class="local">● Local workspace</span></header><%if(message){%><div class="notice"><%=message%></div><%}%>
<%if(page==='dashboard'){%><section class="hero"><div><small>KEEP IT SIMPLE</small><h2>Build knowledge, one review at a time.</h2><p>Manage topics, keep interview questions in one place, and track what you revise.</p><a class="btn white" href="/?page=tracking">Log a revision →</a></div><div class="hero-art">✧<span>LEARN</span></div></section>
<div class="stats"><article><i>◈</i><small>Total topics</small><strong><%=topics.length%></strong><a href="/?page=topics">Manage →</a></article><article><i class="blue">☷</i><small>Questions saved</small><strong><%=questions.length%></strong><a href="/?page=questions">Open bank →</a></article><article><i class="green">◷</i><small>Minutes today</small><strong><%=todayMinutes%> <em>min</em></strong><a href="/?page=tracking">View log →</a></article><article><i class="orange">↻</i><small>Reviews logged</small><strong><%=revisions.length%></strong></article></div>
<div class="grid"><section class="panel"><div class="heading"><div><small>REVIEW QUEUE</small><h3>Questions to revisit</h3></div><a href="/?page=tracking">Review →</a></div><%if(!dueQuestions.length){%><p class="empty">You're all caught up!</p><%}else{%><%dueQuestions.slice(0,6).forEach(q=>{let t=topics.find(t=>t.id===q.topicId);%><div class="queue"><span>Q</span><div><b><%=q.title%></b><small><%=t?t.name:'Topic removed'%></small></div><a href="/?page=tracking&questionId=<%=q.id%>">↗</a></div><%})%><%}%></section><section class="panel"><div class="heading"><div><small>QUICK START</small><h3>What next?</h3></div></div><a class="quick" href="/?page=topics">＋ <span><b>Add a topic</b><small>Organise what you're learning</small></span> →</a><a class="quick" href="/?page=questions">✎ <span><b>Add a question</b><small>Save question and answer</small></span> →</a><a class="quick" href="/?page=tracking">◷ <span><b>Track revision</b><small>Log session and next review</small></span> →</a></section></div>
<section class="panel"><div class="heading"><div><small>LEARNING AREAS</small><h3>Topics at a glance</h3></div><a href="/?page=topics">All topics →</a></div><div class="topic-cards"><%topics.forEach((t,i)=>{%><article><small><%=t.category%></small><h4><%=t.name%></h4><p><%=t.description||'No description yet.'%></p><footer><%=questions.filter(q=>q.topicId===t.id).length%> questions <a href="/?page=questions">Open →</a></footer></article><%})%></div></section><%}%>

<%if(page==='topics'){%><div class="grid two"><section class="panel"><div class="heading"><div><small>ORGANISE YOUR LEARNING</small><h3>Add a topic</h3></div></div><form class="form" method="post" action="/topics"><label>Topic name<input name="name" required placeholder="e.g. Java Concurrency"></label><label>Category<input name="category" placeholder="Java / Spring / Design"></label><label>Description<textarea name="description" rows="3" placeholder="What does this topic cover?"></textarea></label><button class="btn">Create topic</button></form></section><section class="panel"><div class="heading"><div><small>TOPIC LIBRARY</small><h3>All topics · <%=topics.length%></h3></div></div><%topics.forEach(t=>{%><div class="managed"><div><b><%=t.name%></b><small><%=t.category%> · <%=questions.filter(q=>q.topicId===t.id).length%> questions</small><p><%=t.description%></p></div><form method="post" action="/topics/<%=t.id%>/delete" onsubmit="return confirm('Delete topic and its questions?')"><button class="x">×</button></form></div><%})%></section></div><%}%>

<%if(page==='questions'){%><section class="panel"><div class="heading"><div><small>BUILD YOUR QUESTION BANK</small><h3>Add a question</h3></div></div><%if(!topics.length){%><p>Create a topic first.</p><%}else{%><form class="form qform" method="post" action="/questions"><label>Question title<input name="title" required placeholder="e.g. Explain Java Memory Model"></label><label>Topic<select name="topicId"><%topics.forEach(t=>{%><option value="<%=t.id%>"><%=t.name%></option><%})%></select></label><label>Difficulty<select name="difficulty"><option>Easy</option><option selected>Medium</option><option>Hard</option></select></label><label>Question / prompt<textarea name="question" rows="2"></textarea></label><label>Answer / notes<textarea name="answer" rows="3"></textarea></label><label>Tags (comma separated)<input name="tags" placeholder="Collections, Interview"></label><button class="btn">＋ Save question</button></form><%}%></section><section class="panel"><div class="heading"><div><small>YOUR KNOWLEDGE BASE</small><h3>Question bank · <%=questions.length%></h3></div><input id="search" class="search" value="<%=search%>" placeholder="Search questions..."></div><div class="filters"><button class="filter active" data-filter="all">All</button><%topics.forEach(t=>{%><button class="filter" data-filter="<%=t.id%>"><%=t.name%></button><%})%></div><div id="questionList" class="question-list"><%questions.filter(q=>!search||[q.title,q.question,q.answer,...(q.tags||[])].join(' ').toLowerCase().includes(search.toLowerCase())).forEach(q=>{let t=topics.find(t=>t.id===q.topicId);%><article class="question" data-topic="<%=q.topicId%>" data-search="<%=([q.title,q.question,q.answer,...(q.tags||[])].join(' ')).toLowerCase().replace(/"/g,'&quot;')%>"><div class="qmeta"><span class="difficulty <%=q.difficulty.toLowerCase()%>"><%=q.difficulty%></span><span><%=t?t.name:'Topic removed'%></span><form method="post" action="/questions/<%=q.id%>/delete" onsubmit="return confirm('Delete question?')"><button class="x">×</button></form></div><h3><%=q.title%></h3><p><%=q.question%></p><div class="tags"><%q.tags.forEach(tag=>{%><span>#<%=tag%></span><%})%></div><details><summary>Reveal answer / notes ＋</summary><p class="answer"><%=q.answer||'No answer saved yet.'%></p></details><div class="actions"><button class="btn soft revise" data-id="<%=q.id%>">◷ Log revision</button><button class="btn soft edit" data-id="<%=q.id%>" data-title="<%=q.title%>" data-question="<%=q.question%>" data-answer="<%=q.answer%>" data-difficulty="<%=q.difficulty%>" data-tags="<%=q.tags.join(', ')%>">Edit</button></div></article><%})%></div><p id="noResults" class="empty" hidden>No matching questions.</p></section><dialog id="editDialog"><form method="post" id="editForm" class="form"><div class="heading"><h3>Edit question</h3><button type="button" id="closeEdit" class="x">×</button></div><label>Title<input name="title" required></label><label>Question<textarea name="question" rows="3"></textarea></label><label>Answer<textarea name="answer" rows="5"></textarea></label><label>Difficulty<select name="difficulty"><option>Easy</option><option>Medium</option><option>Hard</option></select></label><label>Tags<input name="tags"></label><button class="btn">Save changes</button></form></dialog><%}%>

<%if(page==='tracking'){%><div class="grid two"><section class="panel"><div class="heading"><div><small>MAKE REVISION VISIBLE</small><h3>Log a revision session</h3></div></div><%if(!questions.length){%><p>Add a question first to track revision.</p><%}else{%><form id="revisionForm" class="form"><label>Question revised<select name="questionId" required><%questions.forEach(q=>{let t=topics.find(t=>t.id===q.topicId);%><option value="<%=q.id%>" <%=questionId===q.id?'selected':''%>><%=q.title%> — <%=t?t.name:'Uncategorised'%></option><%})%></select></label><div class="row"><label>Time spent<select name="minutes"><%[5,10,15,20,25,30,45,60].forEach(m=>{%><option <%=m===10?'selected':''%>><%=m%></option><%})%></select></label><label>Recall rating<select name="rating"><option>Again</option><option>Hard</option><option selected>Good</option><option>Easy</option></select></label></div><label>Notes (optional)<textarea name="note" rows="3" placeholder="What did you forget? What to practise?"></textarea></label><button class="btn">Save revision log</button><p class="help">Suggested next review: Again = 1d, Hard = 2d, Good = 4d, Easy = 7d.</p></form><div id="success" class="success" hidden></div><%}%></section><section class="panel"><div class="heading"><div><small>YOUR PROGRESS</small><h3>Revision at a glance</h3></div></div><div class="progress"><small>Today's sessions</small><b><%=todayRevisions.length%></b></div><div class="progress"><small>Today's revision time</small><b><%=todayMinutes%> min</b></div><div class="progress"><small>Total logged reviews</small><b><%=revisions.length%></b></div></section></div><section class="panel"><div class="heading"><div><small>YOUR RECENT WORK</small><h3>Revision history</h3></div><span><%=revisions.length%> logs</span></div><%if(!revisions.length){%><p class="empty">Your revision history starts here. Log your first review above.</p><%}else{[...revisions].reverse().slice(0,50).forEach(r=>{let t=topics.find(t=>t.id===r.topicId);%><div class="history"><span class="tick">✓</span><div><b><%=r.questionTitle%></b><small><%=t?t.name:'Topic removed'%> · <%=r.date%></small><%if(r.note){%><p><%=r.note%></p><%}%></div><aside><span class="rating <%=r.rating.toLowerCase()%>"><%=r.rating%></span><b><%=r.minutes%> min</b><small>Next: <%=r.nextReviewDate%></small></aside></div><%})}%></section><%}%>
<footer class="pagefoot"><span>Revision Hub</span><span>Keep it small. Keep it going. · Stored in local JSON files</span></footer></main><div id="toast" class="toast" role="status"></div><script src="/app.js"></script></body></html>