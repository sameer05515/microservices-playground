<%- include("layout",{title:"My learning"}) %><section class="my-learning-head"><p class="eyebrow">YOUR LEARNING SPACE</p><h1>My learning</h1><p class="muted">Pick up where you left off and keep making progress.</p></section><section class="my-courses"><% if(!courses.length){ %><div class="card empty"><div class="empty-symbol">✦</div><h2>Your next skill is waiting</h2><p class="muted">Enroll in a course to see it here.</p><a class="primary" href="/courses">Explore courses</a></div><% } %><% courses.forEach(c=>{ %><article class="my-course card"><a class="my-course-art art-<%= c.image %>" href="/courses/<%= c.id %>"><span class="course-art-symbol"><%= c.image==='js'?'JS':c.image==='spring'?'☘':c.image==='design'?'✳':'▦' %></span></a><div class="my-course-info"><p class="eyebrow"><%= c.category %></p><h2><a href="/courses/<%= c.id %>"><%= c.title %></a></h2><p class="muted">By <%= c.instructor %> · <%= c.lessons.length %> lessons</p><div class="progress-track"><span style="width:<%= c.progressPercent %>%"></span></div><p class="progress-label"><%= c.progressPercent %>% complete</p><a class="primary" href="/learn/<%= c.id %>"><%= c.progressPercent===100?'Review course':'Continue learning' %> →</a></div></article><% }) %></section><%- include("end") %>
