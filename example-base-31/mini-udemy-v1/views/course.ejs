<%- include("layout",{title:course.title}) %><section class="course-hero"><div class="course-hero-inner"><a class="back-link" href="/courses">← Browse courses</a><p class="eyebrow"><%= course.category %> · <%= course.level %></p><h1><%= course.title %></h1><p class="course-subtitle"><%= course.subtitle %></p><div class="course-meta"><span class="stars">★★★★★</span> <strong><%= course.rating %></strong> <span>(<%= course.reviewCount %> reviews)</span><span>Created by <strong><%= course.instructor %></strong></span></div><p class="meta-small">Updated recently · <%= course.lessons.length %> lessons · Learn at your own pace</p></div></section><div class="detail-grid"><section><article class="card description"><h2>What you'll learn</h2><p><%= course.description %></p><div class="learn-points"><span>✓ Practical concepts</span><span>✓ Self-paced lessons</span><span>✓ Track your progress</span></div></article><section class="curriculum"><h2>Course content</h2><p class="muted"><%= course.lessons.length %> lessons · <%= course.lessons.reduce((n,l)=>n+parseInt(l.duration),0) %> minutes of learning content</p><% course.lessons.forEach((lesson,i)=>{ %><div class="lesson-row"><span class="lesson-number"><%= enrolled&&done.includes(lesson.id)?'✓':String(i+1).padStart(2,'0') %></span><div class="lesson-title"><strong><%= lesson.title %></strong><span><%= lesson.duration %></span></div><% if(enrolled){ %><a class="lesson-open" href="/learn/<%= course.id %>?lesson=<%= lesson.id %>">Open lesson →</a><% }else{ %><span class="lock">Preview</span><% } %></div><% }) %></section><section class="reviews"><h2>Student reviews</h2><% if(!reviews.length){ %><p class="muted">Be the first to review this course after enrolling.</p><% } %><% reviews.forEach(r=>{ %><article class="review"><div class="review-avatar"><%= r.author?.name?.[0]||'S' %></div><div><strong><%= r.author?.name||'Student' %></strong><div class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5-r.rating) %></div><p><%= r.text||'Rated this course.' %></p></div></article><% }) %></section></section><aside class="purchase-card"><div class="purchase-art art-<%= course.image %>"><div class="course-art-symbol"><%= course.image==='js'?'JS':course.image==='spring'?'☘':course.image==='design'?'✳':'▦' %></div><span>COURSE PREVIEW</span></div><div class="purchase-content"><div class="price">₹<%= course.price %></div><p class="muted">One-time demo enrollment</p><% if(enrolled){ %><a class="primary full" href="/learn/<%= course.id %>">Continue learning</a><div class="progress-track"><span style="width:<%= course.progressPercent %>%"></span></div><p class="progress-label"><%= course.progressPercent %>% completed</p><% }else if(me){ %><form method="post" action="/courses/<%= course.id %>/enroll"><button class="primary full">Enroll now</button></form><% }else{ %><a class="primary full" href="/login">Log in to enroll</a><% } %><p class="included-title">This course includes:</p><ul><li>◷ Self-paced lessons</li><li>✓ Progress tracking</li><li>↻ Revisit lessons anytime</li><li>☆ Student review form</li></ul></div></aside></div><% if(enrolled&&!hasReviewed){ %><section class="card review-form"><h2>Leave a review</h2><form method="post" action="/courses/<%= course.id %>/reviews"><label>Rating<select name="rating" required><option value="5">5 - Excellent</option><option value="4">4 - Very good</option><option value="3">3 - Good</option><option value="2">2 - Fair</option><option value="1">1 - Needs improvement</option></select></label><label>Your review<textarea name="text" maxlength="800" rows="3" placeholder="What did you think of this course?"></textarea></label><button class="dark-btn">Submit review</button></form></section><% } %><%- include("end") %>
