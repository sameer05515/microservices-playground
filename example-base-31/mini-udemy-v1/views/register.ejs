<%- include("layout",{title:"Create account"}) %><section class="auth-page"><div class="auth-visual"><div class="visual-orbit">✦</div><p class="eyebrow">MAKE TIME FOR YOURSELF</p><h1>Small lessons.<br>Big possibilities.</h1><p>Build a learning habit, track your progress and keep growing.</p></div><div class="auth-card"><h2>Create your account</h2><p class="muted">Start learning today.</p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/register"><label>Full name<input name="name" maxlength="70" required></label><label>Email address<input type="email" name="email" required></label><label>Password<input type="password" name="password" minlength="8" required></label><label>Confirm password<input type="password" name="confirmPassword" minlength="8" required></label><button class="primary full">Create account</button></form><p class="center muted">Already registered? <a href="/login">Log in</a></p></div></section><%- include("end") %>
