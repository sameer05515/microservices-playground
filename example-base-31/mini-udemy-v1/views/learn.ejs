<%- include("layout",{title:lesson.title}) %><div class="learning-top"><a href="/courses/<%= course.id %>">← <%= course.title %></a><span><%= percent %>% complete</span></div><div class="learning-progress"><span style="width:<%= percent %>%"></span></div><div class="learning-layout"><aside class="curriculum-side"><h2>Course content</h2><p class="muted"><%= done.length %> of <%= course.lessons.length %> lessons complete</p><% course.lessons.forEach((l,i)=>{ %><a class="side-lesson <%= l.id===lesson.id?'selected':'' %>" href="/learn/<%= course.id %>?lesson=<%= l.id %>"><span class="check"><%= done.includes(l.id)?'✓':String(i+1).padStart(2,'0') %></span><span><strong><%= l.title %></strong><small><%= l.duration %></small></span></a><% }) %></aside><section class="lesson-content"><p class="eyebrow">LESSON <%= course.lessons.findIndex(l=>l.id===lesson.id)+1 %> OF <%= course.lessons.length %></p><h1><%= lesson.title %></h1><div class="video-placeholder"><div class="play-circle">▶</div><p>LESSON READING</p><span><%= lesson.duration %></span></div><article class="lesson-text"><h2>In this lesson</h2><p><%= lesson.content %></p><div class="tip"><strong>Learning tip</strong><p>Pause here and practise the concept in your own editor before moving to the next lesson.</p></div></article><div class="lesson-footer"><a class="outline" href="/courses/<%= course.id %>">Course overview</a><% if(done.includes(lesson.id)){ %><span class="completed-label">✓ Completed</span><% }else{ %><form method="post" action="/learn/<%= course.id %>/lessons/<%= lesson.id %>/complete"><button class="primary">Mark complete & continue →</button></form><% } %></div></section></div><%- include("end") %>
