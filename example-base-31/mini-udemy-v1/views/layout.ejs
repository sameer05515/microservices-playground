<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Mini Udemy</title><link rel="stylesheet" href="/style.css"></head><body><header class="top"><a class="brand" href="/courses">mini<span>udemy</span></a><form class="search-top" method="get" action="/courses"><input name="q" value="<%= typeof q!=='undefined'?q:'' %>" placeholder="Search for anything" aria-label="Search courses"><button aria-label="Search">⌕</button></form><nav><a href="/courses">Explore</a><% if(me){ %><a href="/my-learning">My learning</a><% } %></nav><% if(me){ %><div class="user-area"><span class="avatar"><%= me.name[0].toUpperCase() %></span><span class="user-name"><%= me.name %></span><form method="post" action="/logout"><button class="outline small">Log out</button></form></div><% }else{ %><div class="auth-nav"><a class="outline" href="/login">Log in</a><a class="dark-btn" href="/register">Sign up</a></div><% } %></header><main><% if(flash){ %><div class="flash"><%= flash %></div><% } %>
