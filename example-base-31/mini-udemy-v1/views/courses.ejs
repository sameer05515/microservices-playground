<%- include("layout",{title:"Explore courses"}) %><section class="hero"><div class="hero-copy"><p class="eyebrow">LEARN ON YOUR TERMS</p><h1>Invest in yourself.<br><span>Unlock your next skill.</span></h1><p>Explore practical courses in development, design and technology. Learn at your own pace, one lesson at a time.</p><a class="primary hero-button" href="#catalog">Explore courses ↓</a></div><div class="hero-art"><div class="art-card art-main"><span class="art-icon">✦</span><p>YOUR LEARNING<br>JOURNEY</p><strong>Starts here.</strong></div><div class="art-card art-float">✓ Lesson complete</div><div class="art-card art-float2">↗ New skills</div></div></section><section class="stats"><div><strong><%= courses.length %></strong><span>courses to explore</span></div><div><strong>Learn</strong><span>at your own pace</span></div><div><strong>Track</strong><span>your progress</span></div></section><section id="catalog" class="catalog"><div class="section-head"><div><p class="eyebrow">THE COURSE LIBRARY</p><h2>Find your next course</h2><p class="muted">Browse the library or search for a topic.</p></div><form class="filter" method="get" action="/courses"><input name="q" value="<%= q %>" placeholder="Course, topic, instructor..."><select name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c %>" <%= category===c?'selected':'' %>><%= c %></option><% }) %></select><button class="dark-btn">Filter</button></form></div><div class="course-grid"><% if(!courses.length){ %><div class="empty"><h3>No courses found</h3><p class="muted">Try another search or category.</p><a href="/courses" class="outline">Clear filters</a></div><% } %><% courses.forEach(c=>{ %><article class="course-card"><a class="course-art art-<%= c.image %>" href="/courses/<%= c.id %>"><span class="art-label"><%= c.category %></span><div class="course-art-symbol"><%= c.image==='js'?'JS':c.image==='spring'?'☘':c.image==='design'?'✳':'▦' %></div><span class="art-bottom">MINI UDEMY · COURSE</span></a><div class="course-info"><p class="course-category"><%= c.category %> · <%= c.level %></p><h3><a href="/courses/<%= c.id %>"><%= c.title %></a></h3><p class="subtitle"><%= c.subtitle %></p><p class="instructor">By <%= c.instructor %></p><div class="rating"><strong><%= c.rating %></strong> <span class="stars">★★★★★</span> <span class="muted">(<%= c.reviewCount %>)</span></div><div class="course-bottom"><strong>₹<%= c.price %></strong><span><%= c.lessons.length %> lessons</span></div><% if(c.enrolled){ %><div class="progress-track"><span style="width:<%= c.progressPercent %>%"></span></div><p class="progress-label"><%= c.progressPercent %>% complete</p><% } %></div></article><% }) %></div></section><%- include("end") %>
