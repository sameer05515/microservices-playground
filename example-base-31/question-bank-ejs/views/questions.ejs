<%- include("partials/head", { title: "Questions • Question Bank" }) %>

<section class="page-header">
  <div>
    <div class="eyebrow">Knowledge Base</div>
    <h1>Questions</h1>
    <p><%= totalFiltered %> result<%= totalFiltered === 1 ? "" : "s" %></p>
  </div>
  <a class="secondary" href="/random">Random ↯</a>
</section>

<form class="filterbar" action="/questions" method="get">
  <input name="q" value="<%= query %>" placeholder="Search...">
  <% if (activeTag) { %><input type="hidden" name="tag" value="<%= activeTag %>"><% } %>
  <button class="primary" type="submit">Search</button>
  <% if (query || activeTag) { %><a class="secondary" href="/questions">Clear</a><% } %>
</form>

<div class="chip-row">
  <a class="chip <%= !activeTag ? 'active' : '' %>" href="/questions<%= query ? '?q='+encodeURIComponent(query) : '' %>">All</a>
  <% bank.tags.forEach(tag => { %>
    <a class="chip <%= activeTag === tag.id ? 'active' : '' %>"
       href="/questions?tag=<%= encodeURIComponent(tag.id) %><%= query ? '&q='+encodeURIComponent(query) : '' %>">
       <%= tag.name %>
    </a>
  <% }) %>
</div>

<div class="list">
  <% if (!questions.length) { %>
    <div class="empty">
      <div class="empty-icon">⌕</div>
      <h2>No questions found</h2>
      <p>Try a different search term or remove the tag filter.</p>
    </div>
  <% } %>

  <% questions.forEach(q => { %>
    <a class="list-card" href="/questions/<%= q.id %>">
      <div class="list-number">#<%= q.number %></div>
      <div class="list-content">
        <h2><%- q.question.split("\n")[0].replace(/^#+\s*/, "") %></h2>
        <p><%= q.answers[0].replace(/[#*`>\[\]]/g, "").replace(/\s+/g, " ").slice(0, 220) %><%= q.answers[0].length > 220 ? "…" : "" %></p>
        <div class="tag-row">
          <% q.tagNames.forEach(name => { %><span class="mini-tag"><%= name %></span><% }) %>
        </div>
      </div>
      <span class="arrow">→</span>
    </a>
  <% }) %>
</div>

<% if (totalPages > 1) { 
   const qs = new URLSearchParams();
   if (query) qs.set("q", query);
   if (activeTag) qs.set("tag", activeTag);
%>
<nav class="pagination">
  <% if (page > 1) { %>
    <a class="secondary" href="/questions?<%= qs.toString() %>&page=<%= page-1 %>">← Previous</a>
  <% } else { %><span></span><% } %>
  <span>Page <strong><%= page %></strong> of <strong><%= totalPages %></strong></span>
  <% if (page < totalPages) { %>
    <a class="secondary" href="/questions?<%= qs.toString() %>&page=<%= page+1 %>">Next →</a>
  <% } else { %><span></span><% } %>
</nav>
<% } %>

<%- include("partials/foot", { bank }) %>