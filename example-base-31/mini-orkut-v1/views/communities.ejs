<%- include("layout",{title:"Communities"}) %><div class="heading"><div><small>FIND YOUR TRIBE</small><h1>Communities</h1><p class="muted">Shared interests, familiar faces, good conversations.</p></div></div><div class="communities"><% communities.forEach((c,i)=>{ %><article class="card community"><div class="art art<%= i%3 %>"><%= ["⌘","♫","✦"][i%3] %></div><h2><%= c.name %></h2><p class="muted"><%= c.description %></p><div class="row"><span class="muted"><%= c.count %> members</span><form method="post" action="/communities/<%= c.id %>/toggle"><button class="<%= c.joined?'button':'primary' %>"><%= c.joined?'Leave':'Join community' %></button></form></div></article><% }) %></div><%- include("end") %>
