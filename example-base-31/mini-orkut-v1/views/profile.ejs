<%- include("layout",{title:profile.name}) %><section class="profile-head"><div class="avatar large"><%= profile.name[0].toUpperCase() %></div><div class="grow"><small>MEMBER PROFILE</small><h1><%= profile.name %></h1><p class="muted">@<%= profile.username %><%= profile.location?' · '+profile.location:'' %></p></div><% if(!own&&!isFriend&&!sent&&!incoming){ %><form method="post" action="/friends/request/<%= profile.id %>"><button class="primary">＋ Add friend</button></form><% }else if(isFriend){ %><span class="badge">✓ Friends</span><% }else if(sent){ %><span class="badge">Request sent</span><% }else if(incoming){ %><a class="button" href="/friends">Respond to request</a><% } %></section><div class="profile-grid"><section class="card"><h2>About me</h2><% if(own){ %><form method="post" action="/profile"><label>Name<input name="name" value="<%= profile.name %>" required></label><label>About<textarea name="bio" rows="4"><%= profile.bio %></textarea></label><label>Location<input name="location" value="<%= profile.location %>"></label><label>Interests<input name="interests" value="<%= profile.interests %>"></label><button class="primary">Save profile</button></form><% }else{ %><p><%= profile.bio||"This member hasn't written a bio yet." %></p><% if(profile.interests){ %><h3>Interests</h3><p><%= profile.interests %></p><% } %><% } %><hr><p>Friends <strong><%= friends.length %></strong></p><p class="muted">Member since <%= new Date(profile.createdAt).toLocaleDateString() %></p></section><section><h2 class="section-title"><%= own?'Your scraps':profile.name+"'s scraps" %></h2><% if(own){ %><form class="card composer" method="post" action="/posts"><textarea name="content" maxlength="1000" placeholder="Leave a new scrap..." required></textarea><button class="primary">Post scrap</button></form><% } %><% if(!posts.length){ %><div class="card center"><h3>No scraps yet</h3><p class="muted">Posts will show up here.</p></div><% } %><% posts.forEach(p=>{ %><article class="card post"><div class="post-head"><div class="avatar"><%= profile.name[0].toUpperCase() %></div><div><strong><%= profile.name %></strong><div class="muted tiny"><%= new Date(p.createdAt).toLocaleString() %></div></div><% if(own){ %><form class="delete" method="post" action="/posts/<%= p.id %>?_method=DELETE"><button>×</button></form><% } %></div><p class="post-content"><%= p.content %></p></article><% }) %></section></div><%- include("end") %>
