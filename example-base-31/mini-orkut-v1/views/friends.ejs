<%- include("layout",{title:"Friends"}) %><div class="heading"><div><small>YOUR CIRCLE</small><h1>Friends</h1><p class="muted">People who make your little corner brighter.</p></div><a class="button" href="/people">＋ Find people</a></div><% if(requests.length){ %><section class="card"><h2>Friend requests</h2><div class="people"><% requests.forEach(r=>{ %><article class="person"><div class="avatar large"><%= r.from.name[0].toUpperCase() %></div><h3><%= r.from.name %></h3><p class="muted">@<%= r.from.username %></p><form method="post" action="/friends/respond/<%= r.id %>"><button class="primary" name="action" value="accept">Accept</button><button class="button" name="action" value="decline">Decline</button></form></article><% }) %></div></section><% } %><section class="card"><h2>Your friends <span class="badge"><%= friends.length %></span></h2><% if(!friends.length){ %><div class="center"><p class="muted">Your circle starts here. Search for people and send your first request.</p><a class="button" href="/people">Find people</a></div><% }else{ %><div class="people"><% friends.forEach(u=>{ %><article class="person"><div class="avatar large"><%= u.name[0].toUpperCase() %></div><h3><%= u.name %></h3><p class="muted">@<%= u.username %></p><a class="button" href="/profile/<%= u.username %>">View profile</a></article><% }) %></div><% } %></section><%- include("end") %>
