<%- include("layout",{title:"Find people"}) %><div class="heading"><div><small>DISCOVER</small><h1>Find your people</h1><p class="muted">Search by name, username or location.</p></div></div><form class="card search" method="get" action="/people"><input name="q" value="<%= q %>" placeholder="Try a name, username or city..." required><button class="primary">Search</button></form><section class="card"><h2><%= q?'Search results':'Start with a search' %> <span class="badge"><%= people.length %></span></h2><% if(!people.length){ %><div class="center"><p class="muted"><%= q?'No people found. Try another search.':'Enter a name or location above.' %></p></div><% }else{ %><div class="people"><% people.forEach(u=>{const isFriend=friends.some(f=>f.id===u.id);const pending=requests.some(r=>r.from.id===u.id); %><article class="person"><div class="avatar large"><%= u.name[0].toUpperCase() %></div><h3><%= u.name %></h3><p class="muted">@<%= u.username %></p><a href="/profile/<%= u.username %>">View profile →</a><% if(isFriend){ %><p class="badge">✓ Friends</p><% }else if(pending){ %><p class="badge">Request pending</p><% }else{ %><form method="post" action="/friends/request/<%= u.id %>"><button class="primary">＋ Add friend</button></form><% } %></article><% }) %></div><% } %></section><%- include("end") %>
