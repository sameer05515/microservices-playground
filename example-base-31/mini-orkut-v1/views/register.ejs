<%- include("layout",{title:"Register"}) %><section class="auth"><div class="hero"><div class="logo">o</div><small>MAKE YOURSELF AT HOME</small><h1>Orkut vibes.<br>A fresh start.</h1><p>Make your profile, find friends and build your community.</p></div><div class="panel"><h2>Create account</h2><p class="muted">It only takes a minute.</p><% if(error){ %><p class="error"><%= error %></p><% } %><form method="post" action="/register"><label>Name<input name="name" maxlength="70" required></label><label>Username<input name="username" minlength="3" maxlength="20" required></label><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" minlength="8" required></label><label>Confirm password<input type="password" name="confirm" minlength="8" required></label><button class="primary">Create account</button></form><p class="center muted">Already a member? <a href="/login">Log in</a></p></div></section><%- include("end") %>
