<%- include("layout",{title:"Home"}) %><div class="heading"><div><small>YOUR HOME</small><h1>What's happening?</h1><p class="muted">A little update from your corner of the internet.</p></div><a class="button" href="/profile/<%= me.username %>">Your profile ↗</a></div><div class="grid"><aside><section class="card center"><div class="avatar large"><%= me.name[0].toUpperCase() %></div><h3><%= me.name %></h3><p class="muted">@<%= me.username %></p><a class="button" href="/profile/<%= me.username %>">Edit profile</a></section><section class="card"><h3>Your space</h3><p><a href="/friends">♧ Friends (<%= friends.length %>)</a></p><p><a href="/communities">◉ Communities</a></p><p><a href="/people">⌕ Find people</a></p></section></aside><section><form class="card composer" method="post" action="/posts"><label for="content">Leave a scrap for your friends</label><textarea id="content" name="content" maxlength="1000" placeholder="What's on your mind?" required></textarea><button class="primary">Post scrap ↗</button></form><h2 class="section-title">Recent scraps <span class="badge"><%= posts.length %></span></h2><% if(!posts.length){ %><div class="card center"><h3>Your feed is waiting</h3><p class="muted">Post your first scrap or add friends to see updates here.</p><a class="button" href="/people">Find people</a></div><% } %><% posts.forEach(p=>{ %><article class="card post"><div class="post-head"><div class="avatar"><%= (p.author?.name||"?")[0].toUpperCase() %></div><div><strong><a href="/profile/<%= p.author?.username||'' %>"><%= p.author?.name||"Member" %></a></strong><div class="muted tiny">@<%= p.author?.username||"unknown" %> · <%= new Date(p.createdAt).toLocaleString() %></div></div><% if(p.userId===me.id){ %><form class="delete" method="post" action="/posts/<%= p.id %>?_method=DELETE"><button title="Delete">×</button></form><% } %></div><p class="post-content"><%= p.content %></p></article><% }) %></section><aside><section class="card"><h3>Friend requests <span class="badge"><%= requests.length %></span></h3><% if(!requests.length){ %><p class="muted">No pending requests.</p><a href="/people">Find people →</a><% } %><% requests.forEach(r=>{ %><div class="request"><a href="/profile/<%= r.from.username %>"><strong><%= r.from.name %></strong></a><form method="post" action="/friends/respond/<%= r.id %>"><button name="action" value="accept">Accept</button><button name="action" value="decline" class="subtle">Decline</button></form></div><% }) %></section><section class="card note"><h3>Small world, big memories.</h3><p>Good things happen when you stay connected.</p></section></aside></div><%- include("end") %>
