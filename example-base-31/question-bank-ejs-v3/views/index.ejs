<%- include("partials/head", { title: "Question Bank" }) %>

<section class="hero">
  <div>
    <div class="eyebrow">Interview Preparation</div>
    <h1>Your personal technical knowledge base.</h1>
    <p>Browse Java, Spring Boot, microservices, ReactJS, JavaScript and system-design questions stored in <code>question-bank.json</code>.</p>
    <form class="hero-search" action="/questions" method="get">
      <input name="q" placeholder="Search questions, answers, code, tags..." autocomplete="off">
      <button class="primary" type="submit">Search</button>
    </form>
  </div>
  <a class="random-card" href="/random">
    <span class="random-icon">↯</span>
    <strong>Random Question</strong>
    <small>Practice without choosing a topic</small>
  </a>
</section>

<section class="stats">
  <div class="stat"><strong><%= bank.questions.length %></strong><span>Questions</span></div>
  <div class="stat"><strong><%= bank.tags.length %></strong><span>Tags</span></div>
  <div class="stat"><strong><%= bank.questions.filter(q => q.answers?.length).length %></strong><span>Answered</span></div>
  <div class="stat"><strong><%= bank.version %></strong><span>Data version</span></div>
</section>

<section class="section-head">
  <div>
    <div class="eyebrow">Topics</div>
    <h2>Browse by tag</h2>
  </div>
</section>

<div class="tag-grid">
  <% bank.tags.forEach(tag => { 
       const count = bank.questions.filter(q => q.tags?.includes(tag.id)).length;
  %>
    <a class="tag-card" href="/questions?tag=<%= encodeURIComponent(tag.id) %>">
      <span class="tag-dot"></span>
      <strong><%= tag.name %></strong>
      <span><%= count %> questions</span>
    </a>
  <% }) %>
</div>

<section class="section-head recent-head">
  <div>
    <div class="eyebrow">Start here</div>
    <h2>Recent questions</h2>
  </div>
  <a class="text-link" href="/questions">View all →</a>
</section>

<div class="question-grid">
  <% questions.slice(0, 6).forEach(q => { %>
    <a class="question-card" href="/questions/<%= q.id %>">
      <div class="q-number">#<%= q.number %></div>
      <h3><%- q.question.split("\n")[0].replace(/^#+\s*/, "") %></h3>
      <div class="card-bottom">
        <span><%= q.answers.length %> answer<%= q.answers.length === 1 ? "" : "s" %></span>
        <% if (q.tagNames.length) { %><span class="mini-tag"><%= q.tagNames[0] %></span><% } %>
      </div>
    </a>
  <% }) %>
</div>

<%- include("partials/foot", { bank }) %>