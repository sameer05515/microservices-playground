<%- include("layout",{title:"Find people"}) %><div class="page-title"><h1>Find people</h1><p class="muted">Search by name, username or location.</p></div><form class="card search" method="get" action="/people"><input name="q" value="<%= q %>" placeholder="Search people..." required><button class="blue">Search</button></form><section class="card"><h2><%= q?'Search results':'Start with a search' %> <span class="count"><%= people.length %></span></h2><% if(!people.length){ %><div class="empty"><h3><%= q?'No people found':'Who are you looking for?' %></h3><p class="muted"><%= q?'Try another search.':'Search by name, username or city.' %></p></div><% }else{ %><div class="people-grid"><% people.forEach(u=>{const fr=friends.some(f=>f.id===u.id),pending=requests.some(r=>r.from.id===u.id); %><article class="person"><span class="profile-pic small-pic"><%= u.name[0].toUpperCase() %></span><h3><%= u.name %></h3><p class="muted">@<%= u.username %></p><a href="/profile/<%= u.username %>">View profile</a><% if(fr){ %><p class="count">✓ Friends</p><% }else if(pending){ %><p class="count">Request pending</p><% }else{ %><form method="post" action="/friends/request/<%= u.id %>"><button class="blue">Add friend</button></form><% } %></article><% }) %></div><% } %></section><%- include("end") %>
