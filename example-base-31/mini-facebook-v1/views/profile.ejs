<%- include("layout",{title:profile.name}) %><section class="cover"><div class="cover-art"></div><div class="profile-bar"><span class="profile-pic"><%= profile.name[0].toUpperCase() %></span><div class="profile-name"><h1><%= profile.name %></h1><p class="muted">@<%= profile.username %><%= profile.location?' · '+profile.location:'' %></p></div><% if(!own&&!isFriend&&!sent&&!incoming){ %><form method="post" action="/friends/request/<%= profile.id %>"><button class="blue">＋ Add friend</button></form><% }else if(isFriend){ %><span class="count">✓ Friends</span><% }else if(sent){ %><span class="count">Request sent</span><% }else if(incoming){ %><a class="gray linkbtn" href="/friends">Respond to request</a><% } %></div></section><div class="profile-grid"><aside class="card"><h2>Intro</h2><% if(own){ %><form class="profile-form" method="post" action="/profile"><label>Name<input name="name" value="<%= profile.name %>" required></label><label>Bio<textarea name="bio" rows="3"><%= profile.bio %></textarea></label><label>Location<input name="location" value="<%= profile.location %>"></label><button class="blue">Save profile</button></form><% }else{ %><p><%= profile.bio||'No bio added yet.' %></p><% if(profile.location){ %><p class="muted">⌖ <%= profile.location %></p><% } %><% } %><hr><p>Friends <strong><%= friends.length %></strong></p><p class="muted">Joined <%= new Date(profile.createdAt).toLocaleDateString() %></p></aside><section><% if(own){ %><form class="card composer" method="post" action="/posts"><textarea name="content" maxlength="1500" placeholder="What's on your mind?" required></textarea><button class="blue">Post</button></form><% } %><% if(!posts.length){ %><div class="card empty"><h2>No posts yet</h2><p class="muted">Posts will appear here.</p></div><% } %><% posts.forEach(p=>{ %><article class="card post"><div class="post-head"><span class="tiny"><%= profile.name[0].toUpperCase() %></span><div class="author"><strong><%= profile.name %></strong><span><%= new Date(p.createdAt).toLocaleString() %></span></div><% if(own){ %><form method="post" action="/posts/<%= p.id %>?_method=DELETE"><button class="more">···</button></form><% } %></div><p class="post-text"><%= p.content %></p><div class="stats"><span>👍 <%= p.likes %> likes</span><span><%= p.comments.length %> comments</span></div><div class="actions"><form method="post" action="/posts/<%= p.id %>/like"><button class="<%= p.liked?'is-liked':'' %>">👍 <%= p.liked?'Liked':'Like' %></button></form><a href="#comments-<%= p.id %>">💬 Comment</a></div><div class="comments" id="comments-<%= p.id %>"><% p.comments.forEach(c=>{ %><div class="comment"><span class="tiny mini"><%= c.author?.name?.[0]||'?' %></span><div><strong><%= c.author?.name||'Member' %></strong><p><%= c.content %></p></div></div><% }) %><form class="comment-form" method="post" action="/posts/<%= p.id %>/comments"><input name="content" maxlength="500" placeholder="Write a comment..." required><button>Send</button></form></div></article><% }) %></section></div><%- include("end") %>
