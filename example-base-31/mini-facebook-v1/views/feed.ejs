<%- include("layout",{title:"Home"}) %><div class="feed"><aside class="left"><a class="side" href="/profile/<%= me.username %>"><span class="tiny"><%= me.name[0].toUpperCase() %></span><%= me.name %></a><a class="side" href="/friends">♧ Friends <b><%= friends.length %></b></a><a class="side" href="/people">⌕ Find people</a><a class="side" href="/notifications">♢ Notifications</a><p class="muted side-note">Your little corner of the social web.</p></aside><section class="center-feed"><form class="card composer" method="post" action="/posts"><div class="compose-row"><span class="tiny"><%= me.name[0].toUpperCase() %></span><textarea name="content" maxlength="1500" placeholder="What's on your mind, <%= me.name.split(' ')[0] %>?" required></textarea></div><div class="compose-foot"><span class="muted">✎ Share a thought with your friends</span><button class="blue">Post</button></div></form><% if(!posts.length){ %><div class="card empty"><div class="f-circle">f</div><h2>Welcome to your feed</h2><p class="muted">Your posts and your friends' updates will appear here.</p><a class="blue linkbtn" href="/people">Find people</a></div><% } %><% posts.forEach(p=>{ %><article class="card post"><div class="post-head"><span class="tiny"><%= p.author?.name?.[0]||'?' %></span><div class="author"><a href="/profile/<%= p.author?.username||'' %>"><strong><%= p.author?.name||'Member' %></strong></a><span><%= new Date(p.createdAt).toLocaleString() %></span></div><% if(p.userId===me.id){ %><form method="post" action="/posts/<%= p.id %>?_method=DELETE"><button class="more">···</button></form><% } %></div><p class="post-text"><%= p.content %></p><div class="stats"><span>👍 <%= p.likes %> likes</span><span><%= p.comments.length %> comments</span></div><div class="actions"><form method="post" action="/posts/<%= p.id %>/like"><button class="<%= p.liked?'is-liked':'' %>">👍 <%= p.liked?'Liked':'Like' %></button></form><a href="#comments-<%= p.id %>">💬 Comment</a></div><div class="comments" id="comments-<%= p.id %>"><% p.comments.forEach(c=>{ %><div class="comment"><span class="tiny mini"><%= c.author?.name?.[0]||'?' %></span><div><strong><%= c.author?.name||'Member' %></strong><p><%= c.content %></p></div></div><% }) %><form class="comment-form" method="post" action="/posts/<%= p.id %>/comments"><input name="content" maxlength="500" placeholder="Write a comment..." required><button>Send</button></form></div></article><% }) %></section><aside class="right"><section class="card"><h3>Friend requests <span class="count"><%= requests.length %></span></h3><% if(!requests.length){ %><p class="muted">No new requests right now.</p><a href="/people">Find people →</a><% } %><% requests.forEach(r=>{ %><div class="request"><span class="tiny"><%= r.from.name[0] %></span><div><strong><%= r.from.name %></strong><div class="req-actions"><form method="post" action="/friends/respond/<%= r.id %>"><button class="blue mini-btn" name="action" value="accept">Confirm</button></form><form method="post" action="/friends/respond/<%= r.id %>"><button class="gray mini-btn" name="action" value="decline">Delete</button></form></div></div></div><% }) %></section><section class="card muted">Share a moment, say hello, and keep up with your circle.</section></aside></div><%- include("end") %>
