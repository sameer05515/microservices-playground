<%- include("layout",{title:"Friends"}) %><div class="page-title"><h1>Friends</h1><p class="muted">Your circle, all in one place.</p></div><% if(requests.length){ %><section class="card"><h2>Friend requests <span class="count"><%= requests.length %></span></h2><div class="people-grid"><% requests.forEach(r=>{ %><article class="person"><span class="profile-pic small-pic"><%= r.from.name[0] %></span><h3><%= r.from.name %></h3><p class="muted">@<%= r.from.username %></p><form method="post" action="/friends/respond/<%= r.id %>"><button class="blue" name="action" value="accept">Confirm</button><button class="gray" name="action" value="decline">Delete</button></form></article><% }) %></div></section><% } %><section class="card"><h2>Your friends <span class="count"><%= friends.length %></span></h2><% if(!friends.length){ %><div class="empty"><h3>Your circle starts here</h3><p class="muted">Search for people and send a friend request.</p><a class="blue linkbtn" href="/people">Find people</a></div><% }else{ %><div class="people-grid"><% friends.forEach(u=>{ %><article class="person"><span class="profile-pic small-pic"><%= u.name[0] %></span><h3><%= u.name %></h3><p class="muted">@<%= u.username %></p><a class="gray linkbtn" href="/profile/<%= u.username %>">View profile</a></article><% }) %></div><% } %></section><%- include("end") %>
