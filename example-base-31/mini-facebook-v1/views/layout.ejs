<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Mini Facebook</title><link rel="stylesheet" href="/style.css"></head><body><header class="top"><a class="brand" href="<%= me?'/feed':'/login' %>">f</a><% if(me){ %><form class="top-search" action="/people"><input name="q" placeholder="Search people"></form><nav><a href="/feed">⌂ Home</a><a href="/friends">♧ Friends</a><a href="/people">⌕ People</a></nav><div class="top-right"><a href="/profile/<%= me.username %>"><span class="tiny"><%= me.name[0].toUpperCase() %></span> <%= me.name %></a><a class="circle" href="/notifications">♢</a><form method="post" action="/logout"><button class="circle">↪</button></form></div><% } %></header><main><% if(flash){ %><div class="flash"><%= flash %></div><% } %>
