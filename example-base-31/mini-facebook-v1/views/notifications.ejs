<%- include("layout",{title:"Notifications"}) %><div class="page-title"><h1>Notifications</h1><p class="muted">Friend requests and account activity.</p></div><section class="card"><% if(!notifications.length){ %><div class="empty"><h2>You're all caught up</h2><p class="muted">New friend requests will appear here.</p></div><% }else{ %><% notifications.forEach(n=>{ %><div class="notification"><span class="tiny"><%= n.from?.name?.[0]||'?' %></span><div><strong><%= n.from?.name||'Member' %></strong><p class="muted"><%= n.status==='pending'?'sent you a friend request':n.status==='accepted'?'is now your friend':'friend request declined' %></p></div><span class="muted"><%= new Date(n.createdAt).toLocaleDateString() %></span></div><% }) %><% } %></section><%- include("end") %>
